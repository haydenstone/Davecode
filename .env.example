# AENIMUS environment example v0.1.0
AENIMUS_HOST=127.0.0.1
AENIMUS_PORT=8787
AENIMUS_WORKSPACE=/workspace
AENIMUS_DATA_DIR=/data
AENIMUS_OLLAMA_URL=http://host.docker.internal:11434
AENIMUS_REQUIRE_APPROVAL=true
AENIMUS_MAX_FILE_BYTES=1048576
AENIMUS_COMMAND_TIMEOUT=30
AENIMUS_QDRANT_URL=http://qdrant:6333
AENIMUS_EMBEDDING_MODEL=nomic-embed-text
# Arbitrary Ollama or OpenAI-compatible providers; keys reference environment names.
AENIMUS_PROVIDERS_JSON={"opencode":{"label":"OpenCode bridge","base_url":"http://host.docker.internal:4096/v1","protocol":"openai"}}
# Discord is an opt-in Compose profile. Use a restricted channel and user allowlist.
DISCORD_BOT_TOKEN=
AENIMUS_DISCORD_CHANNEL_ID=
AENIMUS_DISCORD_ALLOWED_USER_IDS=
AENIMUS_DISCORD_COMMAND_PREFIX=!aenimus
# Provider secrets belong in environment variables, never agent JSON.
# OPENAI_API_KEY=
